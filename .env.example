# Copy to .env for npm development or Docker Compose. Generate both passwords locally.
DATABASE_URL=postgresql://eventlens:replace-with-db-password@localhost:5432/eventlens
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ETHEREUM_RPC_URL=https://ethereum.publicnode.com

# Docker Compose uses this to initialize PostgreSQL and construct DATABASE_URL.
# Use URL-safe characters, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-db-password
